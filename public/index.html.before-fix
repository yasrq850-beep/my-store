<!doctype html><html lang="ar" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>MY STORE</title><style>
*{box-sizing:border-box}body{margin:0;font-family:Arial;background:#f4f4f4;color:#222}.top{background:#111;color:white;padding:15px;text-align:center;position:sticky;top:0;z-index:5}.nav{display:flex;gap:6px;overflow:auto;background:#222;padding:8px}.nav button,.cats button,button{border:0;border-radius:9px;padding:10px 14px;background:#eee;cursor:pointer}.nav button{color:#111;white-space:nowrap}.page{display:none;padding:12px}.page.active{display:block}.card{background:white;border-radius:14px;padding:14px;margin-bottom:12px;box-shadow:0 2px 8px #0001}input,select,textarea{width:100%;padding:11px;margin:5px 0 10px;border:1px solid #ccc;border-radius:9px;font-size:16px}.primary{background:#111!important;color:#fff!important}.danger{background:#c62828!important;color:white!important}.green{background:#16843b!important;color:white!important}.cats{display:flex;gap:7px;overflow:auto;padding:5px 0}.cats button{white-space:nowrap}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(155px,1fr));gap:10px}.product{background:white;border-radius:13px;overflow:hidden;position:relative;box-shadow:0 2px 7px #0001}.product img{width:100%;height:160px;object-fit:cover;background:#ddd}.pbody{padding:10px}.old{text-decoration:line-through;color:#888}.discount{position:absolute;top:7px;left:7px;background:#d00;color:#fff;padding:5px 8px;border-radius:20px}.row{display:flex;gap:7px;align-items:center}.row>*{flex:1}.badge{display:inline-block;padding:5px 8px;background:#eee;border-radius:15px}.total{font-size:20px;font-weight:bold}.empty{text-align:center;padding:30px;color:#777}
</style></head><body>
<div class="top"><h2 id="storeName">MY STORE</h2><div>متجرك في مكان واحد</div></div>
<div class="nav">
<button onclick="page('home')">🏠 الرئيسية</button><button onclick="page('sections')">📂 الأقسام</button><button onclick="page('products')">🛍️ المنتجات</button><button onclick="page('cart')">🛒 السلة <b id="cartCount">0</b></button><button onclick="page('orders')">📦 الطلبات</button><button onclick="page('add')">➕ إضافة منتج</button><button onclick="page('settings')">⚙️ الإعدادات</button>
</div>

<section id="home" class="page active"><div class="card"><h2>🛍️ المتجر</h2><div id="homeCats" class="cats"></div></div><div id="homeProducts" class="grid"></div></section>

<section id="sections" class="page"><div class="card"><h2>📂 الأقسام</h2><div class="row"><input id="newCat" placeholder="اسم القسم"><button class="primary" onclick="addCategory()">+ إضافة قسم</button></div><div id="catList"></div></div></section>

<section id="products" class="page"><div class="card"><h2 id="productTitle">🛍️ المنتجات</h2><div id="productCats" class="cats"></div></div><div id="productsList" class="grid"></div></section>

<section id="add" class="page"><div class="card"><h2>➕ إضافة منتج</h2>
<input id="pn" placeholder="اسم المنتج"><input id="pq" type="number" placeholder="الكمية">
<input id="pp" type="number" step="0.01" placeholder="السعر الأصلي">
<input id="ps" type="number" step="0.01" placeholder="السعر بعد الخصم">
<select id="pc"></select>
<label>📷 صورة المنتج</label><input id="pi" type="file" accept="image/*" capture="environment" onchange="preview(this)"><img id="preview" style="max-width:100%;max-height:220px;display:none;border-radius:12px">
<textarea id="pd" placeholder="وصف المنتج"></textarea><button class="primary" onclick="addProduct()">حفظ المنتج</button>
</div></section>

<section id="cart" class="page"><div class="card"><h2>🛒 السلة</h2><div id="cartList"></div><div class="total" id="cartTotal"></div><input id="customer" placeholder="اسم العميل"><input id="phone" placeholder="رقم الهاتف"><select id="payment"><option>الدفع عند الاستلام</option><option>تحويل بنكي</option><option>نقدي</option></select><button class="green" onclick="order()">تأكيد الطلب</button></div></section>

<section id="orders" class="page"><div class="card"><h2>📦 الطلبات</h2><div id="ordersList"></div></div></section>

<section id="settings" class="page"><div class="card"><h2>⚙️ الإعدادات</h2><input id="sn" placeholder="اسم المتجر"><select id="currency"><option>USD</option><option>EUR</option><option>GBP</option><option> NOK</option><option>SAR</option><option>AED</option></select><select id="lang"><option value="ar">العربية</option><option value="en">English</option></select><button class="primary" onclick="saveSettings()">حفظ الإعدادات</button></div>
<div class="card"><h3>👥 الأدوار</h3><div>👑 المالك — يرى ويدير كل الأقسام</div><div>🧑‍💼 مدير القسم — يدير قسمه</div><div>👷 الموظف — تنفيذ الطلبات</div><div>👤 العميل — تصفح وسلة وطلبات</div></div>
<div class="card"><h3>⭐ النقاط والإحالة</h3><div>النقاط والإحالات جاهزة كأساس للتطوير القادم.</div></div></section>

<script>
let D={categories:[],products:[],orders:[],settings:{}},cart=[],currentCat="";
const $=id=>document.getElementById(id);
async function api(u,o){let r=await fetch(u,o);return r.json()}
async function load(){D=await api("/api/db");$("storeName").textContent=D.settings.storeName||"MY STORE";renderCats();renderProducts();renderCart();renderOrders();$("sn").value=D.settings.storeName||"";$("currency").value=(D.settings.currency||"USD").trim();$("lang").value=D.settings.language||"ar"}
function page(x){document.querySelectorAll(".page").forEach(e=>e.classList.remove("active"));$(x).classList.add("active");if(x==="products")renderProducts();if(x==="cart")renderCart();if(x==="orders")renderOrders()}
function renderCats(){let h=D.categories.map(c=>`<button onclick='showCat(${JSON.stringify(c)})'>${esc(c)}</button>`).join("");$("homeCats").innerHTML=h;$("productCats").innerHTML='<button onclick="showCat(\\'\\')">كل المنتجات</button>'+h;$("catList").innerHTML=D.categories.map(c=>`<div class="card"><b>📂 ${esc(c)}</b><div class="row"><button onclick='showCat(${JSON.stringify(c)})'>🛍️ منتجات القسم</button><button onclick='shareText(${JSON.stringify(c)})'>📤 مشاركة</button><button class="danger" onclick='delCat(${JSON.stringify(c)})'>🗑️ حذف</button></div></div>`).join("");$("pc").innerHTML=D.categories.map(c=>`<option>${esc(c)}</option>`).join("")}
function showCat(c){currentCat=c;page("products");renderProducts()}
function renderProducts(){let a=currentCat?D.products.filter(p=>p.category===currentCat):D.products; $("productTitle").textContent=currentCat?"🛍️ منتجات قسم: "+currentCat:"🛍️ كل المنتجات";$("productsList").innerHTML=a.length?a.map(card).join(""):'<div class="empty">لا توجد منتجات هنا</div>';$("homeProducts").innerHTML=D.products.slice(0,12).map(card).join("")||'<div class="empty">لا توجد منتجات بعد</div>'}
function card(p){return `<div class="product">${p.discount?`<span class="discount">خصم ${p.discount}%</span>`:""}${p.image?`<img src="${esc(p.image)}">`:`<div style="height:160px;background:#ddd;display:flex;align-items:center;justify-content:center">📦</div>`}<div class="pbody"><b>${esc(p.name)}</b><div>${esc(p.category)}</div><div>${p.salePrice} ${esc(D.settings.currency||"USD")} ${p.price>p.salePrice?`<span class="old">${p.price}</span>`:""}</div><div>الكمية: ${p.qty}</div><div class="row"><button class="primary" onclick='addCart(${JSON.stringify(p.id)})'>🛒 للسلة</button><button onclick='shareProduct(${JSON.stringify(p.id)})'>📤</button><button class="danger" onclick='delProduct(${JSON.stringify(p.id)})'>🗑️</button></div></div></div>`}
async function addCategory(){let n=$("newCat").value.trim();if(!n)return;await api("/api/categories",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({name:n})});$("newCat").value="";await load()}
async function delCat(c){if(!confirm("حذف القسم؟ المنتجات ستنتقل إلى عام."))return;await api("/api/categories/"+encodeURIComponent(c),{method:"DELETE"});await load()}
function preview(x){let f=x.files[0];if(!f)return;let r=new FileReader();r.onload=()=>{$("preview").src=r.result;$("preview").style.display="block";window.img=r.result};r.readAsDataURL(f)}
async function addProduct(){let p={name:$("pn").value,qty:$("pq").value,price:$("pp").value,salePrice:$("ps").value||$("pp").value,category:$("pc").value,image:window.img||"",description:$("pd").value};if(!p.name)return alert("اكتب اسم المنتج");await api("/api/products",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(p)});alert("تم حفظ المنتج");location.reload()}
async function delProduct(id){if(!confirm("حذف المنتج؟"))return;await api("/api/products/"+id,{method:"DELETE"});await load()}
function addCart(id){let p=D.products.find(x=>x.id===id);if(!p)return;let x=cart.find(x=>x.id===id);if(x)x.n++;else cart.push({id,n:1});renderCart();alert("تمت إضافة المنتج للسلة")}
function renderCart(){ $("cartCount").textContent=cart.reduce((a,x)=>a+x.n,0);if(!cart.length){$("cartList").innerHTML='<div class="empty">السلة فارغة</div>';$("cartTotal").textContent="";return}let total=0;$("cartList").innerHTML=cart.map(x=>{let p=D.products.find(p=>p.id===x.id);if(!p)return"";total+=p.salePrice*x.n;return `<div class="card"><b>${esc(p.name)}</b><div>${p.salePrice} × ${x.n}</div><button onclick='cartMinus(${JSON.stringify(x.id)})'>−</button> <button onclick='cartPlus(${JSON.stringify(x.id)})'>+</button></div>`}).join("");$("cartTotal").textContent="المجموع: "+total+" "+(D.settings.currency||"USD")}
function cartPlus(id){let x=cart.find(x=>x.id===id);if(x)x.n++;renderCart()}function cartMinus(id){let x=cart.find(x=>x.id===id);if(x){x.n--;if(x.n<=0)cart=cart.filter(y=>y.id!==id)}renderCart()}
async function order(){if(!cart.length)return alert("السلة فارغة");let items=cart.map(x=>{let p=D.products.find(p=>p.id===x.id);return {id:p.id,name:p.name,qty:x.n,price:p.salePrice}});let total=items.reduce((a,x)=>a+x.price*x.qty,0);let o={customer:$("customer").value,phone:$("phone").value,payment:$("payment").value,items,total,currency:D.settings.currency||"USD"};await api("/api/orders",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(o)});cart=[];renderCart();alert("تم إنشاء الطلب");page("orders");renderOrders()}
async function renderOrders(){let a=await api("/api/orders");$("ordersList").innerHTML=a.length?a.slice().reverse().map(o=>`<div class="card"><b>${o.id}</b><div>العميل: ${esc(o.customer||"غير محدد")}</div><div>المجموع: ${o.total} ${esc(o.currency||"")}</div><div>الدفع: ${esc(o.payment||"")}</div><div class="badge">${esc(o.status)}</div><select onchange='status(${JSON.stringify(o.id)},this.value)'><option>جديد</option><option>قيد التجهيز</option><option>تم الشحن</option><option>مكتمل</option><option>ملغي</option></select></div>`).join(""):'<div class="empty">لا توجد طلبات</div>'}
async function status(id,v){await api("/api/orders/"+id,{method:"PATCH",headers:{"Content-Type":"application/json"},body:JSON.stringify({status:v})});renderOrders()}
async function saveSettings(){await api("/api/settings",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({storeName:$("sn").value,currency:$("currency").value.trim(),language:$("lang").value})});await load();alert("تم حفظ الإعدادات")}
async function shareProduct(id){let p=D.products.find(x=>x.id===id);if(!p)return;let t=`${p.name}\\nالسعر: ${p.salePrice} ${D.settings.currency||""}\\nالقسم: ${p.category}`;if(navigator.share)navigator.share({title:p.name,text:t});else navigator.clipboard.writeText(t).then(()=>alert("تم نسخ معلومات المنتج للمشاركة"))}
function shareText(c){let t="قسم: "+c;if(navigator.share)navigator.share({title:c,text:t});else navigator.clipboard.writeText(t).then(()=>alert("تم نسخ اسم القسم"))}
function esc(x){return String(x??"").replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[m]))}
load();
</script></body></html>
